# Copy to .env and fill in. .env is gitignored.

# Alpaca market data. Paper keys use the paper trading host; live keys need
# With live keys, set the trading URL to https://api.alpaca.markets instead.
LOOKOUT_ALPACA_KEY_ID=
LOOKOUT_ALPACA_SECRET_KEY=
# LOOKOUT_ALPACA_DATA_URL=https://data.alpaca.markets
# LOOKOUT_ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# WhatsApp: Settings > Agents > your agent > Chat info > API key
LOOKOUT_WHATSAPP_TOKEN=

# Optional. When set, each alert includes a short cited explanation.
# LOOKOUT_GEMINI_API_KEY=
# LOOKOUT_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional tuning.
# LOOKOUT_INTERVAL_SECONDS=10
# LOOKOUT_WATCHLIST_PATH=watchlist.yaml
# LOOKOUT_STATE_DIR=state
